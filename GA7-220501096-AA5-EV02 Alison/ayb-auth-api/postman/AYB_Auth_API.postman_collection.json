{
  "info": {
    "name": "AYB Auth API - Testing (GA7-220501096-AA5-EV02)",
    "description": "Pruebas funcionales del servicio web de registro e inicio de sesión. Ejecutar en orden: TC02, TC07, TC08 y TC10 usan el usuario creado en TC01.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
