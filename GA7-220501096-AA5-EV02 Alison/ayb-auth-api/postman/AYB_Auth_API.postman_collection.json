  "item": [
    {
      "name": "TC01 - Registrar usuario (datos válidos)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sufijo = Date.now().toString().slice(-6);",
              "pm.collectionVariables.set('usuarioPrueba', 'alison_' + sufijo);",
              "pm.collectionVariables.set('passwordPrueba', 'Clave123');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código de estado 201', () => pm.response.to.have.status(201));",
              "pm.test('La respuesta es JSON', () => pm.response.to.be.json);",
              "pm.test('Tiempo de respuesta menor a 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
              "pm.test('success = true', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('Mensaje: Registro realizado correctamente', () => pm.expect(pm.response.json().message).to.eql('Registro realizado correctamente'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"password\": \"{{passwordPrueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
